{
  "name": "lingopop-mobile",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "LingoPop 3.0: aventura narrativa única con home, mundos, 90 misiones integradas y un barrio tridimensional",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --host",
    "android:init": "cap add android",
    "ios:init": "cap add ios",
    "sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "check": "node scripts/verify.mjs",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#58cc02\" --splashBackgroundColor \"#f7fbff\"",
    "assets:ios": "capacitor-assets generate --ios --iconBackgroundColor \"#58cc02\" --splashBackgroundColor \"#f7fbff\""
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.0.0",
    "@capacitor/assets": "^3.0.0"
  }
}